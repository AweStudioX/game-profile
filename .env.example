# Leave all values empty for demo mode.
PROFILE_PASSWORD=
# Use a dedicated Postgres database for private platform connections.
DATABASE_URL=
# Generate a separate 32+ character secret, for example with `openssl rand -hex 32`.
PROFILE_ENCRYPTION_KEY=
# Optional: keep both legacy values to reuse an existing Steam connection.
STEAM_ID=
STEAM_WEB_API_KEY=
# Optional Xbox confidential Web OAuth application; personal Microsoft accounts.
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=
# Must exactly match the Microsoft app Web redirect URI, e.g. https://your-domain/connect.html.
XBOX_REDIRECT_URI=
